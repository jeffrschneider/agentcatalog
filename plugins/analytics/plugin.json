            "Name the Sources",
            "Pull the Record",
            "Describe Who Bought",
            "Group the Base",
            "Read the Base over Time",
            "Size Each Group",
            "Compare with the Last Read",
            "Write the Findings",
            "Review the Findings",
            "Issue the Findings as a Version",
            "Hand over the Findings",
            "Set the Next Read",
            "Record What Was Learned"
          ]
        },
        {
          "process": "ref/mkt/announce-company-news",
          "activities": [
