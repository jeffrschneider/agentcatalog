          ]
        },
        {
          "process": "ref/mkt/win-back-campaign",
          "activities": [
            "Take in the Lapsed Segment",
            "Set the Parameters",
            "Settle the Offer",
            "Sort the Segment into Treatments",
            "Brief the Makers",
            "Call the Named Accounts",
