            "Set the Parameters",
            "Launch the Campaigns",
            "Record What Is in Force"
          ]
        },
        {
          "process": "ref/mkt/enable-channel-partner",
          "activities": [
            "Hand over the Selling Kit"
          ]
        },
        {
          "process": "ref/mkt/field-event",
          "activities": [
            "Promote the Event"
          ]
        },
        {
          "process": "ref/mkt/ideal-customer-profile",
          "activities": [
